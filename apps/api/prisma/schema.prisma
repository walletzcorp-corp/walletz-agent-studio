// =============================================================
// Walletz Med — Prisma Schema
// Módulo 1: Organização, Unidades e Acesso
// =============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("DATABASE_URL_SHADOW")
}

// -----------------------------------------------------------
// ENUMERAÇÕES
// -----------------------------------------------------------

enum OrganizationStatus {
  RASCUNHO
  EM_VALIDACAO
  ATIVA
  SUSPENSA
  ENCERRADA
}

enum UnitStatus {
  RASCUNHO
  ATIVA
  BLOQUEADA
  INATIVA
}

enum UserStatus {
  CONVIDADO
  ATIVO
  BLOQUEADO
  ENCERRADO
}

enum InviteStatus {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
}

enum MembershipStatus {
  ATIVO
  BLOQUEADO
  ENCERRADO
}

enum ProfessionalLinkStatus {
  PENDENTE
  VIGENTE
  EXPIRADO
  SUSPENSO
  ENCERRADO
}

enum ResourceStatus {
  RASCUNHO
  ATIVO
  BLOQUEADO
  INATIVO
}

enum ServiceStatus {
  RASCUNHO
  PUBLICADO
  DESCONTINUADO
}

enum OutboxEventStatus {
  PENDENTE
  PROCESSADO
  FALHOU
}

enum AppointmentType {
  CONSULTA
  RETORNO
  SESSAO
  PROCEDIMENTO
  TELECONSULTA
}

enum AppointmentStatus {
  AGENDADO
  CONFIRMADO
  AGUARDANDO
  EM_ATENDIMENTO
  FINALIZADO
  CANCELADO
  NAO_COMPARECEU
  REAGENDADO
}

enum RecurrenceType {
  SEMANAL
  QUINZENAL
  MENSAL
}

enum WaitListStatus {
  AGUARDANDO
  NOTIFICADO
  AGENDADO
  EXPIRADO
  CANCELADO
}

enum QueueStatus {
  ABERTA
  PAUSADA
  FECHADA
}

enum TicketStatus {
  AGUARDANDO
  CHAMADO
  EM_ATENDIMENTO
  FINALIZADO
  DESISTIU
}

// -----------------------------------------------------------
// MÓDULO 4 — ENUMERAÇÕES DO PRONTUÁRIO
// -----------------------------------------------------------

enum EntryStatus {
  RASCUNHO
  AGUARDANDO_ASSINATURA
  ASSINADO
  CANCELADO
}

enum SignatureStatus {
  PENDENTE
  DEMO
  CONFIRMADO
}

enum AllergyStatus {
  ATIVO
  REMISSAO
  NEGADO
}

enum MedicationStatus {
  EM_USO
  SUSPENSO
  ENCERRADO
}

enum DiagnosisType {
  PRINCIPAL
  SECUNDARIO
  COMPLICACAO
  DESCARTADO
}

enum PepAuditAction {
  LEITURA
  IMPRESSAO
  EXPORTACAO
  INCLUSAO
  EDICAO_RASCUNHO
  ASSINATURA
  ADENDO
}

// MÓDULO 5 — PACIENTES E CONSENTIMENTOS
enum ConsentType {
  TERMO_TRATAMENTO
  LGPD_TRATAMENTO
  USO_IMAGEM
  ANESTESIA
  CIRURGIA
  PESQUISA
  MARKETING
  TELEMEDICINA
  COMPARTILHAMENTO
  OUTRO
}

enum ConsentStatus {
  VIGENTE
  REVOGADO
  EXPIRADO
  PENDENTE
}

enum ConsentChannel {
  PRESENCIAL
  DIGITAL
  PORTAL_PACIENTE
  APP
  WHATSAPP
  EMAIL
}

enum AlertType {
  ALERGICO
  MEDICAMENTO
  CONTRAINDICACAO
  RISCO_QUEDA
  ISOLAMENTO
  ADMINISTRATIVO
  SEGURANCA
  OUTRO
}

enum AlertSeverity {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum PatientDocumentType {
  RG
  CPF_DOC
  PASSAPORTE
  CNH
  TITULO_ELEITOR
  CARTAO_SUS
  CERTIDAO_NASCIMENTO
  LAUDO_MEDICO
  EXAME
  OUTRO
}

enum PatientLinkType {
  RESPONSAVEL_LEGAL
  PAI
  MAE
  CONJUGE
  FILHO
  TUTOR
  CUIDADOR
  ACOMPANHANTE
  OUTRO
}

// -----------------------------------------------------------
// TENANT
// -----------------------------------------------------------

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization  Organization?
  users         UserTenant[]
  auditEvents   AuditEvent[]
  outboxEvents  OutboxEvent[]

  @@map("tenants")
}

// -----------------------------------------------------------
// ORGANIZAÇÃO
// -----------------------------------------------------------

model Organization {
  id                String             @id @default(uuid())
  tenantId          String             @unique @map("tenant_id")
  tenant            Tenant             @relation(fields: [tenantId], references: [id])

  razaoSocial       String             @map("razao_social")
  nomeFantasia      String             @map("nome_fantasia")
  cnpj              String             @unique
  email             String?
  telefone          String?
  site              String?

  // Configurações regionais
  timezone          String             @default("America/Sao_Paulo")
  locale            String             @default("pt-BR")
  currency          String             @default("BRL")

  status            OrganizationStatus @default(RASCUNHO)
  statusReason      String?            @map("status_reason")

  rowVersion        Int                @default(0) @map("row_version")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  units             Unit[]
  users             UserOrganization[]
  professionals     Professional[]
  specialties       Specialty[]
  services          Service[]
  auditEvents       AuditEvent[]
  statusHistory     OrganizationStatusHistory[]
  patients          Patient[]
  appointments      Appointment[]
  waitListEntries   WaitListEntry[]
  medicalRecords    MedicalRecord[]
  pepTemplates      PepTemplate[]
  preAdmissionForms PreAdmissionForm[]

  @@map("organizations")
}

model OrganizationStatusHistory {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  organization   Organization       @relation(fields: [organizationId], references: [id])

  fromStatus     OrganizationStatus @map("from_status")
  toStatus       OrganizationStatus @map("to_status")
  reason         String?
  changedBy      String             @map("changed_by")
  changedAt      DateTime           @default(now()) @map("changed_at")

  @@map("organization_status_history")
}

// -----------------------------------------------------------
// UNIDADE
// -----------------------------------------------------------

model Unit {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  code           String
  name           String
  email          String?
  telefone       String?

  // Endereço
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String
  uf             String     @db.Char(2)
  cep            String?

  timezone       String     @default("America/Sao_Paulo")
  responsavelId  String?    @map("responsavel_id")

  status         UnitStatus @default(RASCUNHO)
  statusReason   String?    @map("status_reason")

  // Checklist de ativação
  checklistCompleted Boolean @default(false) @map("checklist_completed")

  rowVersion     Int        @default(0) @map("row_version")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  users             UserUnit[]
  professionals     ProfessionalUnitLink[]
  resources         Resource[]
  auditEvents       AuditEvent[]
  statusHistory     UnitStatusHistory[]
  appointments      Appointment[]
  queues            Queue[]
  availabilityRules AvailabilityRule[]

  @@unique([organizationId, code])
  @@map("units")
}

model UnitStatusHistory {
  id         String     @id @default(uuid())
  unitId     String     @map("unit_id")
  unit       Unit       @relation(fields: [unitId], references: [id])

  fromStatus UnitStatus @map("from_status")
  toStatus   UnitStatus @map("to_status")
  reason     String?
  changedBy  String     @map("changed_by")
  changedAt  DateTime   @default(now()) @map("changed_at")

  @@map("unit_status_history")
}

// -----------------------------------------------------------
// USUÁRIO
// -----------------------------------------------------------

model User {
  id              String     @id @default(uuid())
  keycloakId      String?    @unique @map("keycloak_id")
  email           String     @unique
  name            String
  status          UserStatus @default(CONVIDADO)

  rowVersion      Int        @default(0) @map("row_version")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenants         UserTenant[]
  organizations   UserOrganization[]
  units           UserUnit[]
  invitesSent     Invite[]   @relation("InviteSender")
  invitesReceived Invite[]   @relation("InviteReceived")

  @@map("users")
}

model UserTenant {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id])
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([userId, tenantId])
  @@map("user_tenants")
}

model UserOrganization {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id])
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id])
  profileId      String           @map("profile_id")
  profile        Profile          @relation(fields: [profileId], references: [id])
  status         MembershipStatus @default(ATIVO)
  linkedAt       DateTime         @default(now()) @map("linked_at")
  revokedAt      DateTime?        @map("revoked_at")
  revokedReason  String?          @map("revoked_reason")

  @@unique([userId, organizationId])
  @@map("user_organizations")
}

model UserUnit {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  unitId    String           @map("unit_id")
  unit      Unit             @relation(fields: [unitId], references: [id])
  profileId String           @map("profile_id")
  profile   Profile          @relation(fields: [profileId], references: [id])
  status    MembershipStatus @default(ATIVO)
  linkedAt  DateTime         @default(now()) @map("linked_at")
  revokedAt DateTime?        @map("revoked_at")

  @@unique([userId, unitId])
  @@map("user_units")
}

// -----------------------------------------------------------
// CONVITES
// -----------------------------------------------------------

model Invite {
  id             String       @id @default(uuid())
  email          String
  organizationId String       @map("organization_id")
  profileId      String       @map("profile_id")
  profile        Profile      @relation(fields: [profileId], references: [id])
  senderId       String       @map("sender_id")
  sender         User         @relation("InviteSender", fields: [senderId], references: [id])
  receiverId     String?      @map("receiver_id")
  receiver       User?        @relation("InviteReceived", fields: [receiverId], references: [id])

  token          String       @unique
  status         InviteStatus @default(PENDENTE)
  expiresAt      DateTime     @map("expires_at")
  acceptedAt     DateTime?    @map("accepted_at")

  idempotencyKey String?      @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("invites")
}

// -----------------------------------------------------------
// PERFIS E PERMISSÕES
// -----------------------------------------------------------

model Profile {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String  @map("display_name")
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  permissions         ProfilePermission[]
  userOrganizations   UserOrganization[]
  userUnits           UserUnit[]
  invites             Invite[]

  @@map("profiles")
}

model Permission {
  id          String @id @default(uuid())
  resource    String
  action      String
  description String?

  profiles    ProfilePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model ProfilePermission {
  profileId    String     @map("profile_id")
  profile      Profile    @relation(fields: [profileId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([profileId, permissionId])
  @@map("profile_permissions")
}

// -----------------------------------------------------------
// PROFISSIONAIS
// -----------------------------------------------------------

model Professional {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?  @map("user_id")

  name           String
  cpf            String?  @unique
  email          String?
  telefone       String?

  // Conselho profissional
  councilType    String?  @map("council_type")
  councilNumber  String?  @map("council_number")
  councilUf      String?  @map("council_uf") @db.Char(2)

  rowVersion     Int      @default(0) @map("row_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  specialties       ProfessionalSpecialty[]
  credentials       ProfessionalCredential[]
  unitLinks         ProfessionalUnitLink[]
  appointments      Appointment[]
  availabilityRules AvailabilityRule[]
  careRelationships CareRelationship[]

  @@map("professionals")
}

model ProfessionalCredential {
  id              String    @id @default(uuid())
  professionalId  String    @map("professional_id")
  professional    Professional @relation(fields: [professionalId], references: [id])

  type            String
  number          String
  issuedBy        String?   @map("issued_by")
  issuedAt        DateTime? @map("issued_at")
  expiresAt       DateTime? @map("expires_at")
  documentUrl     String?   @map("document_url")

  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("professional_credentials")
}

model ProfessionalUnitLink {
  id              String                 @id @default(uuid())
  professionalId  String                 @map("professional_id")
  professional    Professional           @relation(fields: [professionalId], references: [id])
  unitId          String                 @map("unit_id")
  unit            Unit                   @relation(fields: [unitId], references: [id])

  role            String?
  startDate       DateTime               @map("start_date")
  endDate         DateTime?              @map("end_date")
  status          ProfessionalLinkStatus @default(PENDENTE)
  statusReason    String?                @map("status_reason")

  rowVersion      Int                    @default(0) @map("row_version")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  @@unique([professionalId, unitId])
  @@map("professional_unit_links")
}

// -----------------------------------------------------------
// ESPECIALIDADES
// -----------------------------------------------------------

model Specialty {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  code           String
  name           String
  description    String?
  active         Boolean  @default(true)

  createdAt      DateTime @default(now()) @map("created_at")

  professionals  ProfessionalSpecialty[]
  services       Service[]
  pepTemplates   PepTemplate[]

  @@unique([organizationId, code])
  @@map("specialties")
}

model ProfessionalSpecialty {
  professionalId String       @map("professional_id")
  professional   Professional @relation(fields: [professionalId], references: [id])
  specialtyId    String       @map("specialty_id")
  specialty      Specialty    @relation(fields: [specialtyId], references: [id])

  @@id([professionalId, specialtyId])
  @@map("professional_specialties")
}

// -----------------------------------------------------------
// RECURSOS (Salas, Equipamentos)
// -----------------------------------------------------------

model Resource {
  id           String         @id @default(uuid())
  unitId       String         @map("unit_id")
  unit         Unit           @relation(fields: [unitId], references: [id])

  code         String
  name         String
  type         String         // consultorio, sala_procedimento, poltrona, maca, equipamento
  description  String?
  capacity     Int?           @default(1)
  floor        String?
  location     String?
  restrictions String?

  status       ResourceStatus @default(RASCUNHO)
  statusReason String?        @map("status_reason")

  rowVersion   Int            @default(0) @map("row_version")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  appointments Appointment[]

  @@unique([unitId, code])
  @@map("resources")
}

// -----------------------------------------------------------
// SERVIÇOS / PROCEDIMENTOS
// -----------------------------------------------------------

model Service {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id])
  specialtyId    String?       @map("specialty_id")
  specialty      Specialty?    @relation(fields: [specialtyId], references: [id])

  code           String
  name           String
  description    String?
  type           String        // consulta, procedimento, exame
  durationMin    Int           @map("duration_min")

  // Requisitos
  requiresProfessional Boolean @default(true) @map("requires_professional")
  requiresRoom         Boolean @default(true) @map("requires_room")

  status         ServiceStatus @default(RASCUNHO)
  version        Int           @default(1)

  rowVersion     Int           @default(0) @map("row_version")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  prices         ServicePrice[]
  appointments   Appointment[]

  @@unique([organizationId, code, version])
  @@map("services")
}

model ServicePrice {
  id          String   @id @default(uuid())
  serviceId   String   @map("service_id")
  service     Service  @relation(fields: [serviceId], references: [id])

  currency    String   @default("BRL")
  amount      Decimal  @db.Decimal(12, 2)
  validFrom   DateTime @map("valid_from")
  validUntil  DateTime? @map("valid_until")

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("service_prices")
}

// -----------------------------------------------------------
// AUDITORIA
// -----------------------------------------------------------

model AuditEvent {
  id             String    @id @default(uuid())
  tenantId       String?   @map("tenant_id")
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  organizationId String?   @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  unitId         String?   @map("unit_id")
  unit           Unit?     @relation(fields: [unitId], references: [id])

  actorId        String?   @map("actor_id")
  actorEmail     String?   @map("actor_email")
  action         String
  resource       String
  resourceId     String?   @map("resource_id")
  result         String    // SUCCESS, FAILURE, DENIED
  reason         String?
  correlationId  String?   @map("correlation_id")

  // Snapshot dos valores (sem senhas, tokens, dados clínicos)
  previousValues Json?     @map("previous_values")
  newValues      Json?     @map("new_values")

  occurredAt     DateTime  @default(now()) @map("occurred_at")

  // Append-only: sem updatedAt, sem delete cascade da app
  @@map("audit_events")
}

// -----------------------------------------------------------
// OUTBOX EVENTS (Transactional Outbox para integração futura)
// -----------------------------------------------------------

model OutboxEvent {
  id          String            @id @default(uuid())
  tenantId    String?           @map("tenant_id")
  tenant      Tenant?           @relation(fields: [tenantId], references: [id])

  eventType   String            @map("event_type")
  aggregateId String            @map("aggregate_id")
  payload     Json

  status      OutboxEventStatus @default(PENDENTE)
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  processedAt DateTime?         @map("processed_at")

  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("outbox_events")
}

// -----------------------------------------------------------
// MÓDULO 3 — AGENDA E JORNADA OPERACIONAL
// -----------------------------------------------------------

model Patient {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  // RF-PAC-001: dados básicos
  name           String
  nomeSocial     String?      @map("nome_social")
  cpf            String?
  cns            String?      // Cartão Nacional de Saúde
  rg             String?
  rgOrgaoEmissor String?      @map("rg_orgao_emissor")
  dataNasc       DateTime?    @map("data_nasc") @db.Date
  sexo           String?      // M, F, O, NI
  estadoCivil    String?      @map("estado_civil")
  nacionalidade  String?
  naturalidade   String?
  etnia          String?
  escolaridade   String?
  profissao      String?
  telefone       String?
  email          String?
  notes          String?

  // RF-PAC-001: endereço
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?      @db.Char(2)
  cep            String?

  // RF-PAC-011: bloqueio de marketing (nunca bloqueia comunicação assistencial)
  marketingBlocked Boolean    @default(false) @map("marketing_blocked")

  // RF-PAC-015: preferências
  preferencias   Json?        // acessibilidade, comunicação, acolhimento

  deactivatedAt  DateTime?    @map("deactivated_at")
  rowVersion     Int          @default(0) @map("row_version")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  appointments    Appointment[]
  waitListEntries WaitListEntry[]
  queueTickets    QueueTicket[]
  medicalRecord   MedicalRecord?
  careRelationships CareRelationship[]

  // Módulo 5
  contacts        PatientContact[]
  alerts          PatientAlert[]
  documents       PatientDocument[]
  consents        PatientConsent[]
  insurances      PatientInsurance[]
  // links as child (this patient is the dependent)
  guardianLinks   PatientLink[]      @relation("PatientLinks_dependent")
  // links as parent (this patient is the guardian/responsible)
  dependentLinks  PatientLink[]      @relation("PatientLinks_guardian")
  formResponses   PreAdmissionFormResponse[]
  auditLogs       PatientAuditLog[]

  @@unique([organizationId, cpf])
  @@unique([organizationId, cns])
  @@map("patients")
}

// RF-AGE-005 — Grade de disponibilidade para agendamento online
model AvailabilityRule {
  id             String       @id @default(uuid())
  unitId         String       @map("unit_id")
  unit           Unit         @relation(fields: [unitId], references: [id])
  professionalId String?      @map("professional_id")
  professional   Professional? @relation(fields: [professionalId], references: [id])

  // 0=Domingo … 6=Sábado
  dayOfWeek      Int          @map("day_of_week")
  startTime      String       @map("start_time") // "HH:MM"
  endTime        String       @map("end_time")   // "HH:MM"
  slotMin        Int          @default(30) @map("slot_min")

  active         Boolean      @default(true)
  validFrom      DateTime?    @map("valid_from") @db.Date
  validUntil     DateTime?    @map("valid_until") @db.Date

  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("availability_rules")
}

// RF-AGE-004 — Séries de agendamento (recorrência / pacote de sessões)
model AppointmentSeries {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")

  recurrenceType RecurrenceType? @map("recurrence_type")
  totalSessions  Int?            @map("total_sessions")
  notes          String?

  createdAt      DateTime        @default(now()) @map("created_at")

  appointments   Appointment[]

  @@map("appointment_series")
}

// RF-AGE-001/002/003/006/007/009 — Agendamento principal
model Appointment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  unitId         String            @map("unit_id")
  unit           Unit              @relation(fields: [unitId], references: [id])
  professionalId String?           @map("professional_id")
  professional   Professional?     @relation(fields: [professionalId], references: [id])
  serviceId      String?           @map("service_id")
  service        Service?          @relation(fields: [serviceId], references: [id])
  resourceId     String?           @map("resource_id")
  resource       Resource?         @relation(fields: [resourceId], references: [id])
  patientId      String            @map("patient_id")
  patient        Patient           @relation(fields: [patientId], references: [id])
  seriesId       String?           @map("series_id")
  series         AppointmentSeries? @relation(fields: [seriesId], references: [id])

  type           AppointmentType   @default(CONSULTA)
  status         AppointmentStatus @default(AGENDADO)

  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")

  // Jornada operacional (RF-AGE-009)
  checkInAt      DateTime?         @map("check_in_at")
  waitingStartAt DateTime?         @map("waiting_start_at")
  startedAt      DateTime?         @map("started_at")
  finishedAt     DateTime?         @map("finished_at")
  checkOutAt     DateTime?         @map("check_out_at")

  // Indicadores (RF-AGE-012)
  waitingMinutes Int?              @map("waiting_minutes")
  delayMinutes   Int?              @map("delay_minutes")

  notes          String?
  cancelReason   String?           @map("cancel_reason")

  // RF-AGE-005
  isOnlineBooking Boolean          @default(false) @map("is_online_booking")

  rowVersion     Int               @default(0) @map("row_version")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  history         AppointmentHistory[]
  waitListEntries WaitListEntry[]  @relation("PromotedAppointment")
  clinicalEntries ClinicalEntry[]
  notifications   AppointmentNotification[]
  tokens          AppointmentToken[]

  @@index([unitId, startsAt])
  @@index([professionalId, startsAt])
  @@index([resourceId, startsAt])
  @@index([patientId])
  @@map("appointments")
}

// Histórico de mudanças de status do agendamento
model AppointmentHistory {
  id            String            @id @default(uuid())
  appointmentId String            @map("appointment_id")
  appointment   Appointment       @relation(fields: [appointmentId], references: [id])

  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  changedBy     String             @map("changed_by")
  reason        String?
  changedAt     DateTime           @default(now()) @map("changed_at")

  @@map("appointment_history")
}

// RF-AGE-008 — Lista de espera
model WaitListEntry {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  unitId         String?        @map("unit_id")
  professionalId String?        @map("professional_id")
  serviceId      String?        @map("service_id")
  patientId      String         @map("patient_id")
  patient        Patient        @relation(fields: [patientId], references: [id])

  // Agendamento gerado ao promover da lista de espera
  scheduledAppointmentId String? @map("scheduled_appointment_id")
  scheduledAppointment   Appointment? @relation("PromotedAppointment", fields: [scheduledAppointmentId], references: [id])

  status         WaitListStatus @default(AGUARDANDO)
  priority       Int            @default(0)
  notes          String?
  notifiedAt     DateTime?      @map("notified_at")

  requestedAt    DateTime       @default(now()) @map("requested_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("wait_list_entries")
}

// RF-AGE-015 — Fila física presencial
model Queue {
  id             String      @id @default(uuid())
  unitId         String      @map("unit_id")
  unit           Unit        @relation(fields: [unitId], references: [id])
  organizationId String      @map("organization_id")

  date           DateTime    @db.Date
  status         QueueStatus @default(ABERTA)
  lastTicketNumber Int       @default(0) @map("last_ticket_number")

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tickets        QueueTicket[]

  @@unique([unitId, date])
  @@map("queues")
}

// Senha / ticket da fila física
model QueueTicket {
  id             String       @id @default(uuid())
  queueId        String       @map("queue_id")
  queue          Queue        @relation(fields: [queueId], references: [id])
  patientId      String?      @map("patient_id")
  patient        Patient?     @relation(fields: [patientId], references: [id])
  serviceId      String?      @map("service_id")
  professionalId String?      @map("professional_id")

  // Número formatado, ex: "A001", "P002"
  ticketNumber   String       @map("ticket_number")
  // 0 = normal; 1 = idoso; 2 = gestante; 3 = deficiente; configurable
  priority       Int          @default(0)
  priorityLabel  String?      @map("priority_label")

  status         TicketStatus @default(AGUARDANDO)

  calledAt       DateTime?    @map("called_at")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")

  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([queueId, ticketNumber])
  @@map("queue_tickets")
}

// -----------------------------------------------------------
// MÓDULO 4 — PRONTUÁRIO ELETRÔNICO DO PACIENTE (PEP)
// -----------------------------------------------------------

// RF-PEP-001: Prontuário longitudinal — um por paciente por organização
model MedicalRecord {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  patientId      String       @unique @map("patient_id")
  patient        Patient      @relation(fields: [patientId], references: [id])

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  entries           ClinicalEntry[]
  allergies         AllergyRecord[]
  medications       MedicationRecord[]
  diagnoses         DiagnosisRecord[]
  medicalHistory    MedicalHistoryRecord[]
  auditLogs         PepAuditLog[]

  @@map("medical_records")
}

// RF-PEP-003: Entrada clínica (SOAP + campos configuráveis)
model ClinicalEntry {
  id             String        @id @default(uuid())
  recordId       String        @map("record_id")
  record         MedicalRecord @relation(fields: [recordId], references: [id])
  organizationId String        @map("organization_id")
  unitId         String        @map("unit_id")
  professionalId String        @map("professional_id")
  appointmentId  String?       @map("appointment_id")
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  templateId     String?       @map("template_id")

  // RF-PEP-003: SOAP
  subjective     String?       // S — queixa principal, história da doença
  objective      String?       // O — exame físico, achados objetivos
  assessment     String?       // A — avaliação clínica
  plan           String?       // P — plano terapêutico

  // Campos adicionais configuráveis (RF-PEP-003)
  extraFields    Json?         @map("extra_fields")

  // RF-PEP-022: rastreio de conteúdo reutilizado
  copiedFromId   String?       @map("copied_from_id")
  copiedFrom     ClinicalEntry? @relation("CopiedEntry", fields: [copiedFromId], references: [id])
  copies         ClinicalEntry[] @relation("CopiedEntry")

  status         EntryStatus   @default(RASCUNHO)

  rowVersion     Int           @default(0) @map("row_version")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  vitalSigns     VitalSigns?
  attachments    ClinicalAttachment[]
  signature      ClinicalEntrySignature?
  addenda        ClinicalEntryAddendum[]
  auditLogs      PepAuditLog[]

  @@index([recordId, createdAt])
  @@index([professionalId])
  @@map("clinical_entries")
}

// RF-PEP-010/011: Adendo — correção rastreável, não apaga o original
model ClinicalEntryAddendum {
  id          String        @id @default(uuid())
  entryId     String        @map("entry_id")
  entry       ClinicalEntry @relation(fields: [entryId], references: [id])

  content     String
  reason      String
  authorSub   String        @map("author_sub")
  authorName  String        @map("author_name")

  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("clinical_entry_addenda")
}

// RF-PEP-004: Sinais vitais por entrada
model VitalSigns {
  id              String        @id @default(uuid())
  entryId         String        @unique @map("entry_id")
  entry           ClinicalEntry @relation(fields: [entryId], references: [id])

  temperatureC    Decimal?      @map("temperature_c") @db.Decimal(4, 1)
  systolicBp      Int?          @map("systolic_bp")
  diastolicBp     Int?          @map("diastolic_bp")
  heartRate       Int?          @map("heart_rate")
  respiratoryRate Int?          @map("respiratory_rate")
  oxygenSatPct    Decimal?      @map("oxygen_sat_pct") @db.Decimal(4, 1)
  weightKg        Decimal?      @map("weight_kg") @db.Decimal(5, 2)
  heightCm        Decimal?      @map("height_cm") @db.Decimal(5, 1)
  bmi             Decimal?      @map("bmi") @db.Decimal(4, 1)
  painScale       Int?          @map("pain_scale")

  // Campos extras para escalas/questionários específicos por especialidade
  extra           Json?

  recordedAt      DateTime      @default(now()) @map("recorded_at")

  @@map("vital_signs")
}

// RF-PEP-005: Alergias (longitudinal)
model AllergyRecord {
  id          String        @id @default(uuid())
  recordId    String        @map("record_id")
  record      MedicalRecord @relation(fields: [recordId], references: [id])

  substance   String
  reaction    String?
  severity    String?       // leve, moderada, grave
  status      AllergyStatus @default(ATIVO)
  onsetDate   DateTime?     @map("onset_date") @db.Date
  notes       String?

  reportedBy  String        @map("reported_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("allergy_records")
}

// RF-PEP-005: Medicamentos em uso (longitudinal)
model MedicationRecord {
  id           String           @id @default(uuid())
  recordId     String           @map("record_id")
  record       MedicalRecord    @relation(fields: [recordId], references: [id])

  name         String
  dosage       String?
  frequency    String?
  route        String?
  startDate    DateTime?        @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  status       MedicationStatus @default(EM_USO)
  indication   String?
  notes        String?

  prescribedBy String           @map("prescribed_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("medication_records")
}

// RF-PEP-005/006: Diagnósticos / CID-10 (longitudinal)
model DiagnosisRecord {
  id           String        @id @default(uuid())
  recordId     String        @map("record_id")
  record       MedicalRecord @relation(fields: [recordId], references: [id])

  cidCode      String?       @map("cid_code")
  description  String
  type         DiagnosisType @default(PRINCIPAL)
  notes        String?

  diagnosedBy  String        @map("diagnosed_by")
  diagnosedAt  DateTime      @default(now()) @map("diagnosed_at")
  resolvedAt   DateTime?     @map("resolved_at")

  @@map("diagnosis_records")
}

// RF-PEP-005: Antecedentes pessoais e familiares (longitudinal)
model MedicalHistoryRecord {
  id          String        @id @default(uuid())
  recordId    String        @map("record_id")
  record      MedicalRecord @relation(fields: [recordId], references: [id])

  // pessoal, familiar, cirurgico, social, ginecologico, etc.
  category    String
  description String
  date        DateTime?     @db.Date
  notes       String?

  reportedBy  String        @map("reported_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("medical_history_records")
}

// RF-PEP-007: Anexos de exames, imagens, laudos e documentos
model ClinicalAttachment {
  id             String        @id @default(uuid())
  entryId        String        @map("entry_id")
  entry          ClinicalEntry @relation(fields: [entryId], references: [id])
  organizationId String        @map("organization_id")

  fileName       String        @map("file_name")
  mimeType       String        @map("mime_type")
  sizeBytes      Int?          @map("size_bytes")
  // relative path under uploads/pep/ directory
  storageKey     String        @map("storage_key")
  description    String?

  uploadedBy     String        @map("uploaded_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@map("clinical_attachments")
}

// RF-PEP-009: Assinatura por adaptador (DEMO ou provedor real)
model ClinicalEntrySignature {
  id             String          @id @default(uuid())
  entryId        String          @unique @map("entry_id")
  entry          ClinicalEntry   @relation(fields: [entryId], references: [id])

  signerSub      String          @map("signer_sub")
  signerName     String          @map("signer_name")
  signerCouncil  String?         @map("signer_council")

  status         SignatureStatus  @default(PENDENTE)
  signedAt       DateTime?       @map("signed_at")

  // Adapter metadata
  providerName   String?         @map("provider_name")
  providerRef    String?         @map("provider_ref")

  createdAt      DateTime        @default(now()) @map("created_at")

  @@map("clinical_entry_signatures")
}

// RF-PEP-002: Modelos de anamnese/evolução por especialidade
model PepTemplate {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  specialtyId    String?      @map("specialty_id")
  specialty      Specialty?   @relation(fields: [specialtyId], references: [id])

  name           String
  // JSON describing the template fields and SOAP configuration
  fields         Json
  active         Boolean      @default(true)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("pep_templates")
}

// RF-PEP-006: Tabela CID-10 com suporte a versionamento
model CidCode {
  id          String   @id @default(uuid())
  code        String
  description String
  category    String?
  version     String   @default("10")
  active      Boolean  @default(true)

  @@unique([code, version])
  @@index([code])
  @@index([description])
  @@map("cid_codes")
}

// RF-PEP-012: Log de auditoria específico do prontuário
model PepAuditLog {
  id           String         @id @default(uuid())
  recordId     String?        @map("record_id")
  record       MedicalRecord? @relation(fields: [recordId], references: [id])
  entryId      String?        @map("entry_id")
  entry        ClinicalEntry? @relation(fields: [entryId], references: [id])

  actorSub     String         @map("actor_sub")
  actorName    String         @map("actor_name")
  action       PepAuditAction
  resourceType String         @map("resource_type")
  resourceId   String         @map("resource_id")

  occurredAt   DateTime       @default(now()) @map("occurred_at")

  @@index([recordId])
  @@index([entryId])
  @@map("pep_audit_logs")
}

// RF-PEP-013: Relação assistencial (profissional–paciente)
model CareRelationship {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  patientId      String       @map("patient_id")
  patient        Patient      @relation(fields: [patientId], references: [id])
  professionalId String       @map("professional_id")
  professional   Professional @relation(fields: [professionalId], references: [id])
  unitId         String?      @map("unit_id")

  startDate      DateTime     @default(now()) @map("start_date")
  endDate        DateTime?    @map("end_date")

  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([patientId, professionalId, organizationId])
  @@map("care_relationships")
}

// -----------------------------------------------------------
// MÓDULO 5 — PACIENTES E CONSENTIMENTOS
// -----------------------------------------------------------

// RF-PAC-002: Contatos de emergência e responsáveis
model PatientContact {
  id             String       @id @default(uuid())
  patientId      String       @map("patient_id")
  patient        Patient      @relation(fields: [patientId], references: [id])
  organizationId String       @map("organization_id")

  name           String
  relationship   String       // parentesco livre ou PatientLinkType value
  telefone       String?
  email          String?
  cpf            String?
  isPrimary      Boolean      @default(false) @map("is_primary")
  isEmergency    Boolean      @default(false) @map("is_emergency")
  notes          String?

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([patientId])
  @@map("patient_contacts")
}

// RF-PAC-003: Planos de saúde e convênios
model PatientInsurance {
  id             String       @id @default(uuid())
  patientId      String       @map("patient_id")
  patient        Patient      @relation(fields: [patientId], references: [id])
  organizationId String       @map("organization_id")

  operator       String       // nome da operadora
  planName       String       @map("plan_name")
  cardNumber     String?      @map("card_number")
  validUntil     DateTime?    @db.Date @map("valid_until")
  planType       String?      @map("plan_type")  // INDIVIDUAL, FAMILIAR, EMPRESARIAL
  notes          String?
  active         Boolean      @default(true)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([patientId])
  @@map("patient_insurances")
}

// RF-PAC-006: Alertas clínicos no cabeçalho (só visíveis em contexto assistencial)
model PatientAlert {
  id             String        @id @default(uuid())
  patientId      String        @map("patient_id")
  patient        Patient       @relation(fields: [patientId], references: [id])
  organizationId String        @map("organization_id")

  type           AlertType
  severity       AlertSeverity @default(MEDIA)
  message        String
  active         Boolean       @default(true)
  resolvedAt     DateTime?     @map("resolved_at")
  resolvedBy     String?       @map("resolved_by")
  createdBy      String        @map("created_by")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([patientId, active])
  @@map("patient_alerts")
}

// RF-PAC-007: Documentos anexados ao cadastro do paciente
model PatientDocument {
  id             String              @id @default(uuid())
  patientId      String              @map("patient_id")
  patient        Patient             @relation(fields: [patientId], references: [id])
  organizationId String              @map("organization_id")

  type           PatientDocumentType
  fileName       String              @map("file_name")
  mimeType       String              @map("mime_type")
  sizeBytes      Int?                @map("size_bytes")
  storageKey     String              @map("storage_key")  // uploads/patients/{orgId}/{patientId}/...
  description    String?
  issuedAt       DateTime?           @db.Date @map("issued_at")
  expiresAt      DateTime?           @db.Date @map("expires_at")

  uploadedBy     String              @map("uploaded_by")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([patientId])
  @@map("patient_documents")
}

// RF-PAC-008: Consentimentos por finalidade, versão, canal e validade
model PatientConsent {
  id             String          @id @default(uuid())
  patientId      String          @map("patient_id")
  patient        Patient         @relation(fields: [patientId], references: [id])
  organizationId String          @map("organization_id")

  type           ConsentType
  status         ConsentStatus   @default(VIGENTE)
  channel        ConsentChannel
  version        String          // versão do termo apresentado
  documentUrl    String?         @map("document_url")

  // Dados do consentimento
  signedAt       DateTime        @default(now()) @map("signed_at")
  signedBy       String          @map("signed_by")      // sub do autenticado ou "PACIENTE"
  signedByName   String          @map("signed_by_name")
  validUntil     DateTime?       @db.Date @map("valid_until")
  ipAddress      String?         @map("ip_address")     // canal digital
  notes          String?

  // Revogação (mantém histórico — NÃO apaga)
  revokedAt      DateTime?       @map("revoked_at")
  revokedBy      String?         @map("revoked_by")
  revokedByName  String?         @map("revoked_by_name")
  revocationReason String?       @map("revocation_reason")

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([patientId, type, status])
  @@map("patient_consents")
}

// RF-PAC-013: Vínculos entre pacientes (dependente ↔ responsável/guardião)
model PatientLink {
  id              String          @id @default(uuid())
  organizationId  String          @map("organization_id")

  // quem guarda / é responsável
  guardianId      String          @map("guardian_id")
  guardian        Patient         @relation("PatientLinks_guardian", fields: [guardianId], references: [id])
  // quem é dependente
  dependentId     String          @map("dependent_id")
  dependent       Patient         @relation("PatientLinks_dependent", fields: [dependentId], references: [id])

  linkType        PatientLinkType @map("link_type")
  validUntil      DateTime?       @db.Date @map("valid_until")
  notes           String?
  active          Boolean         @default(true)

  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([guardianId, dependentId, organizationId])
  @@index([dependentId])
  @@map("patient_links")
}

// RF-PAC-014: Formulários pré-atendimento com versionamento
model PreAdmissionForm {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  version        String       @default("1.0")
  fields         Json         // array of {name, label, type, required, options?}
  active         Boolean      @default(true)

  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  responses      PreAdmissionFormResponse[]

  @@index([organizationId, active])
  @@map("pre_admission_forms")
}

model PreAdmissionFormResponse {
  id             String           @id @default(uuid())
  formId         String           @map("form_id")
  form           PreAdmissionForm @relation(fields: [formId], references: [id])
  patientId      String           @map("patient_id")
  patient        Patient          @relation(fields: [patientId], references: [id])
  organizationId String           @map("organization_id")

  answers        Json             // {fieldName: value}
  formVersion    String           @map("form_version") // snapshot da versão
  submittedAt    DateTime         @default(now()) @map("submitted_at")
  submittedBy    String           @map("submitted_by") // sub do autenticado
  notes          String?

  @@index([patientId, formId])
  @@map("pre_admission_form_responses")
}

// RF-AGE-006: Notificações de agendamento (rastreamento + idempotência)
model AppointmentNotification {
  id             String      @id @default(uuid())
  appointmentId  String      @map("appointment_id")
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  organizationId String      @map("organization_id")

  channel        String      // WHATSAPP, SMS, EMAIL
  event          String      // CONFIRMACAO, CANCELAMENTO, REAGENDAMENTO, LEMBRETE
  idempotencyKey String      @unique @map("idempotency_key") // appointmentId:event:channel

  status         String      @default("PENDENTE") // PENDENTE, ENVIADO, FALHOU, DEMO
  recipient      String      // telefone ou email — nunca logado em claro
  content        String?
  sentAt         DateTime?   @map("sent_at")
  failReason     String?     @map("fail_reason")
  isDemo         Boolean     @default(false) @map("is_demo")

  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@map("appointment_notifications")
}

// RF-AGE-007: Tokens seguros para link de confirmação/cancelamento/reagendamento
model AppointmentToken {
  id             String      @id @default(uuid())
  appointmentId  String      @map("appointment_id")
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  organizationId String      @map("organization_id")

  token          String      @unique // token aleatório seguro — NUNCA logado
  action         String      // CONFIRMAR, CANCELAR, REAGENDAR
  expiresAt      DateTime    @map("expires_at")
  usedAt         DateTime?   @map("used_at")

  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@map("appointment_tokens")
}

// ============================================================
// MÓDULO 7 — EST: Estoque, Compras e Rastreabilidade
// ============================================================

enum StockItemType {
  CONSUMIVEL
  MEDICAMENTO
  EQUIPAMENTO
  MATERIAL
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  PERDA
  DESCARTE
  DEVOLUCAO
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
  RESERVA
  LIBERACAO_RESERVA
  CONSUMO
}

enum StockTransferStatus {
  PENDENTE
  ENVIADO
  RECEBIDO
  DIVERGENCIA
  CANCELADO
}

model StockCategory {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  name           String
  description    String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  items          StockItem[]

  @@index([organizationId])
  @@map("stock_categories")
}

model StockItem {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  categoryId        String?        @map("category_id")
  category          StockCategory? @relation(fields: [categoryId], references: [id])
  code              String?
  name              String
  description       String?
  unitOfMeasure     String         @map("unit_of_measure")
  presentation      String?
  type              StockItemType  @default(CONSUMIVEL)
  requiresLot       Boolean        @default(false) @map("requires_lot")
  requiresColdChain Boolean        @default(false) @map("requires_cold_chain")
  minStock          Decimal?       @map("min_stock") @db.Decimal(15, 4)
  maxStock          Decimal?       @map("max_stock") @db.Decimal(15, 4)
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  lots         StockLot[]
  balances     StockBalance[]
  movements    StockMovement[]
  reservations StockReservation[]
  transferLines StockTransferLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("stock_items")
}

model StockLot {
  id               String    @id @default(uuid())
  itemId           String    @map("item_id")
  item             StockItem @relation(fields: [itemId], references: [id])
  organizationId   String    @map("organization_id")
  lotNumber        String    @map("lot_number")
  supplierName     String?   @map("supplier_name")
  manufacturerDate DateTime? @map("manufacturer_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  unitCost         Decimal?  @map("unit_cost") @db.Decimal(15, 4)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")

  movements     StockMovement[]
  transferLines StockTransferLine[]

  @@unique([itemId, lotNumber])
  @@index([organizationId])
  @@map("stock_lots")
}

model StockBalance {
  id             String    @id @default(uuid())
  itemId         String    @map("item_id")
  item           StockItem @relation(fields: [itemId], references: [id])
  organizationId String    @map("organization_id")
  unitId         String    @map("unit_id")
  quantity       Decimal   @default(0) @db.Decimal(15, 4)
  reservedQty    Decimal   @default(0) @map("reserved_qty") @db.Decimal(15, 4)
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([itemId, organizationId, unitId])
  @@index([organizationId, unitId])
  @@map("stock_balances")
}

model StockMovement {
  id             String            @id @default(uuid())
  itemId         String            @map("item_id")
  item           StockItem         @relation(fields: [itemId], references: [id])
  lotId          String?           @map("lot_id")
  lot            StockLot?         @relation(fields: [lotId], references: [id])
  organizationId String            @map("organization_id")
  unitId         String            @map("unit_id")
  type           StockMovementType
  quantity       Decimal           @db.Decimal(15, 4)
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(15, 4)
  totalCost      Decimal?          @map("total_cost") @db.Decimal(15, 4)
  reason         String?
  referenceType  String?           @map("reference_type")
  referenceId    String?           @map("reference_id")
  idempotencyKey String?           @unique @map("idempotency_key")
  performedBy    String            @map("performed_by")
  performedAt    DateTime          @default(now()) @map("performed_at")

  @@index([itemId, organizationId, unitId])
  @@index([organizationId, performedAt])
  @@map("stock_movements")
}

model StockReservation {
  id             String    @id @default(uuid())
  itemId         String    @map("item_id")
  item           StockItem @relation(fields: [itemId], references: [id])
  organizationId String    @map("organization_id")
  unitId         String    @map("unit_id")
  quantity       Decimal   @db.Decimal(15, 4)
  referenceType  String    @map("reference_type")
  referenceId    String    @map("reference_id")
  status         String    @default("ATIVA")
  createdAt      DateTime  @default(now()) @map("created_at")
  consumedAt     DateTime? @map("consumed_at")
  releasedAt     DateTime? @map("released_at")

  @@index([organizationId, unitId])
  @@index([referenceType, referenceId])
  @@map("stock_reservations")
}

model StockTransfer {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  fromUnitId     String              @map("from_unit_id")
  toUnitId       String              @map("to_unit_id")
  status         StockTransferStatus @default(PENDENTE)
  notes          String?
  requestedBy    String              @map("requested_by")
  requestedAt    DateTime            @default(now()) @map("requested_at")
  receivedBy     String?             @map("received_by")
  receivedAt     DateTime?           @map("received_at")
  cancelledBy    String?             @map("cancelled_by")
  cancelledAt    DateTime?           @map("cancelled_at")
  cancelReason   String?             @map("cancel_reason")

  lines StockTransferLine[]

  @@index([organizationId])
  @@map("stock_transfers")
}

model StockTransferLine {
  id           String        @id @default(uuid())
  transferId   String        @map("transfer_id")
  transfer     StockTransfer @relation(fields: [transferId], references: [id])
  itemId       String        @map("item_id")
  item         StockItem     @relation(fields: [itemId], references: [id])
  lotId        String?       @map("lot_id")
  lot          StockLot?     @relation(fields: [lotId], references: [id])
  requestedQty Decimal       @map("requested_qty") @db.Decimal(15, 4)
  sentQty      Decimal?      @map("sent_qty") @db.Decimal(15, 4)
  receivedQty  Decimal?      @map("received_qty") @db.Decimal(15, 4)

  @@index([transferId])
  @@map("stock_transfer_lines")
}

// ============================================================
// MÓDULO 8 — FIN: Financeiro, Fiscal e Repasses
// ============================================================

enum TransactionType {
  RECEITA
  DESPESA
}

enum TransactionStatus {
  PENDENTE
  PARCIALMENTE_PAGO
  PAGO
  CANCELADO
  VENCIDO
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  PIX
  TRANSFERENCIA
  CONVENIO
  OUTRO
}

model FinancialAccount {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  name           String
  type           String
  bankName       String?   @map("bank_name")
  accountNumber  String?   @map("account_number")
  initialBalance Decimal   @default(0) @map("initial_balance") @db.Decimal(15, 2)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  payments FinancialPayment[]

  @@index([organizationId])
  @@map("financial_accounts")
}

model FinancialCategory {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  name           String
  type           TransactionType
  parentId       String?             @map("parent_id")
  parent         FinancialCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       FinancialCategory[] @relation("CategoryTree")
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at")

  transactions FinancialTransaction[]

  @@index([organizationId])
  @@map("financial_categories")
}

model FinancialTransaction {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  unitId         String?             @map("unit_id")
  categoryId     String?             @map("category_id")
  category       FinancialCategory?  @relation(fields: [categoryId], references: [id])
  type           TransactionType
  status         TransactionStatus   @default(PENDENTE)
  description    String
  amount         Decimal             @db.Decimal(15, 2)
  paidAmount     Decimal             @default(0) @map("paid_amount") @db.Decimal(15, 2)
  dueDate        DateTime            @map("due_date") @db.Date
  referenceType  String?             @map("reference_type")
  referenceId    String?             @map("reference_id")
  patientId      String?             @map("patient_id")
  professionalId String?             @map("professional_id")
  notes          String?
  idempotencyKey String?             @unique @map("idempotency_key")
  createdBy      String              @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  cancelledAt    DateTime?           @map("cancelled_at")
  cancelReason   String?             @map("cancel_reason")

  payments FinancialPayment[]

  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@index([referenceType, referenceId])
  @@map("financial_transactions")
}

model FinancialPayment {
  id              String               @id @default(uuid())
  transactionId   String               @map("transaction_id")
  transaction     FinancialTransaction @relation(fields: [transactionId], references: [id])
  accountId       String?              @map("account_id")
  account         FinancialAccount?    @relation(fields: [accountId], references: [id])
  amount          Decimal              @db.Decimal(15, 2)
  method          PaymentMethod        @default(DINHEIRO)
  paidAt          DateTime             @default(now()) @map("paid_at")
  reversedAt      DateTime?            @map("reversed_at")
  reversedBy      String?              @map("reversed_by")
  reversalReason  String?              @map("reversal_reason")
  notes           String?
  idempotencyKey  String?              @unique @map("idempotency_key")
  recordedBy      String               @map("recorded_by")

  @@index([transactionId])
  @@map("financial_payments")
}

model FinancialPeriod {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  year           Int
  month          Int
  status         String    @default("ABERTO")
  closedBy       String?   @map("closed_by")
  closedAt       DateTime? @map("closed_at")
  closeReason    String?   @map("close_reason")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([organizationId, year, month])
  @@map("financial_periods")
}

// ============================================================
// MÓDULO 9 — TIS: Convênios, TISS e Glosas
// ============================================================

enum GuideType {
  CONSULTA
  SP_SADT
  INTERNACAO
  HONORARIOS
}

enum GuideStatus {
  RASCUNHO
  PENDENTE_AUTORIZACAO
  AUTORIZADO
  NEGADO
  ENVIADO
  PAGO
  GLOSADO
  PARCIALMENTE_PAGO
  RECURSO
  CANCELADO
}

enum LotStatus {
  ABERTO
  FECHADO
  ENVIADO
  RETORNADO
  PAGO
  CANCELADO
}

enum ClaimStatus {
  ABERTA
  APRESENTADA
  ACEITA
  NEGADA
  RECURSO
}

model InsuranceCarrier {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  ansCode         String             @map("ans_code")
  name            String
  tradeName       String?            @map("trade_name")
  cnpj            String?
  phone           String?
  email           String?
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  plans     InsurancePlan[]
  contracts InsuranceContract[]

  @@unique([organizationId, ansCode])
  @@index([organizationId])
  @@map("insurance_carriers")
}

model InsurancePlan {
  id          String           @id @default(uuid())
  carrierId   String           @map("carrier_id")
  carrier     InsuranceCarrier @relation(fields: [carrierId], references: [id])
  name        String
  planCode    String           @map("plan_code")
  planType    String           @map("plan_type")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")

  contracts InsuranceContract[]

  @@unique([carrierId, planCode])
  @@index([carrierId])
  @@map("insurance_plans")
}

model InsuranceContract {
  id                 String           @id @default(uuid())
  organizationId     String           @map("organization_id")
  carrierId          String           @map("carrier_id")
  carrier            InsuranceCarrier @relation(fields: [carrierId], references: [id])
  planId             String?          @map("plan_id")
  plan               InsurancePlan?   @relation(fields: [planId], references: [id])
  contractNumber     String           @map("contract_number")
  tissVersion        String           @map("tiss_version") // ex: "3.05.00"
  operatorCode       String           @map("operator_code")
  providerCode       String           @map("provider_code")
  validFrom          DateTime         @map("valid_from") @db.Date
  validUntil         DateTime?        @map("valid_until") @db.Date
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  guides InsuranceGuide[]
  lots   InsuranceLot[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@map("insurance_contracts")
}

model TussCode {
  id            String    @id @default(uuid())
  organizationId String   @map("organization_id")
  code          String
  description   String
  tableCode     String    @map("table_code")
  version       String
  validFrom     DateTime  @map("valid_from") @db.Date
  validUntil    DateTime? @map("valid_until") @db.Date
  unitValue     Decimal?  @map("unit_value") @db.Decimal(15, 4)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  guideItems InsuranceGuideItem[]

  @@unique([organizationId, code, version])
  @@index([organizationId])
  @@map("tuss_codes")
}

model InsuranceGuide {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  contractId       String            @map("contract_id")
  contract         InsuranceContract @relation(fields: [contractId], references: [id])
  guideType        GuideType
  status           GuideStatus       @default(RASCUNHO)
  guideNumber      String?           @map("guide_number")
  authorizationNumber String?        @map("authorization_number")

  patientId        String?           @map("patient_id")
  appointmentId    String?           @map("appointment_id")
  professionalId   String?           @map("professional_id")
  unitId           String            @map("unit_id")

  serviceDate      DateTime          @map("service_date") @db.Date
  validationErrors Json?             @map("validation_errors")

  idempotencyKey   String?           @unique @map("idempotency_key")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  submittedAt      DateTime?         @map("submitted_at")
  paidAt           DateTime?         @map("paid_at")
  cancelledAt      DateTime?         @map("cancelled_at")

  items    InsuranceGuideItem[]
  lotItems InsuranceLotItem[]
  claims   InsuranceClaim[]

  @@index([organizationId])
  @@index([contractId])
  @@map("insurance_guides")
}

model InsuranceGuideItem {
  id          String         @id @default(uuid())
  guideId     String         @map("guide_id")
  guide       InsuranceGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  tussCodeId  String?        @map("tuss_code_id")
  tussCode    TussCode?      @relation(fields: [tussCodeId], references: [id])
  description String
  quantity    Decimal        @db.Decimal(15, 4)
  unitValue   Decimal        @map("unit_value") @db.Decimal(15, 4)
  totalValue  Decimal        @map("total_value") @db.Decimal(15, 4)
  tableCode   String?        @map("table_code")
  itemCode    String?        @map("item_code")

  @@index([guideId])
  @@map("insurance_guide_items")
}

model InsuranceLot {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  contractId      String            @map("contract_id")
  contract        InsuranceContract @relation(fields: [contractId], references: [id])
  lotNumber       String            @map("lot_number")
  status          LotStatus         @default(ABERTO)
  competenceMonth Int               @map("competence_month")
  competenceYear  Int               @map("competence_year")
  totalValue      Decimal           @default(0) @map("total_value") @db.Decimal(15, 2)
  xmlPayload      String?           @map("xml_payload") @db.Text
  protocolNumber  String?           @map("protocol_number")
  sentAt          DateTime?         @map("sent_at")
  returnedAt      DateTime?         @map("returned_at")
  returnNotes     String?           @map("return_notes")
  paidValue       Decimal?          @map("paid_value") @db.Decimal(15, 2)
  paidAt          DateTime?         @map("paid_at")
  createdBy       String            @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  items InsuranceLotItem[]

  @@unique([organizationId, lotNumber])
  @@index([organizationId])
  @@map("insurance_lots")
}

model InsuranceLotItem {
  id      String         @id @default(uuid())
  lotId   String         @map("lot_id")
  lot     InsuranceLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  guideId String         @map("guide_id")
  guide   InsuranceGuide @relation(fields: [guideId], references: [id])
  value   Decimal        @db.Decimal(15, 2)

  @@unique([lotId, guideId])
  @@index([lotId])
  @@map("insurance_lot_items")
}

model InsuranceClaim {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  guideId        String         @map("guide_id")
  guide          InsuranceGuide @relation(fields: [guideId], references: [id])
  status         ClaimStatus    @default(ABERTA)
  itemDescription String        @map("item_description")
  claimReason    String         @map("claim_reason")
  claimCode      String?        @map("claim_code")
  glosedValue    Decimal        @map("glosed_value") @db.Decimal(15, 2)
  responsibleParty String       @map("responsible_party")
  dueDate        DateTime?      @map("due_date") @db.Date
  resolvedAt     DateTime?      @map("resolved_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  appeals InsuranceClaimAppeal[]

  @@index([organizationId])
  @@index([guideId])
  @@map("insurance_claims")
}

model InsuranceClaimAppeal {
  id          String         @id @default(uuid())
  claimId     String         @map("claim_id")
  claim       InsuranceClaim @relation(fields: [claimId], references: [id])
  appealText  String         @map("appeal_text") @db.Text
  documentRef String?        @map("document_ref")
  submittedBy String         @map("submitted_by")
  submittedAt DateTime       @default(now()) @map("submitted_at")
  result      String?
  resultAt    DateTime?      @map("result_at")

  @@index([claimId])
  @@map("insurance_claim_appeals")
}

// ============================================================
// MÓDULO 10 — CRM: CRM e Comunicação
// ============================================================

enum LeadStatus {
  NOVO
  QUALIFICADO
  EM_CONTATO
  NEGOCIACAO
  CONVERTIDO
  PERDIDO
}

enum OpportunityStatus {
  ABERTA
  GANHA
  PERDIDA
  PAUSADA
}

enum ActivityType {
  LIGACAO
  EMAIL
  WHATSAPP
  REUNIAO
  TAREFA
  NOTA
}

enum CrmTicketStatus {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO
}

enum CrmTicketPriority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

model CrmFunnel {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  name           String
  description    String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  stages       CrmFunnelStage[]
  opportunities CrmOpportunity[]

  @@index([organizationId])
  @@map("crm_funnels")
}

model CrmFunnelStage {
  id          String     @id @default(uuid())
  funnelId    String     @map("funnel_id")
  funnel      CrmFunnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  probability Int        @default(50)
  isWon       Boolean    @default(false) @map("is_won")
  isLost      Boolean    @default(false) @map("is_lost")

  opportunities CrmOpportunity[]

  @@unique([funnelId, position])
  @@index([funnelId])
  @@map("crm_funnel_stages")
}

model CrmLead {
  id              String     @id @default(uuid())
  organizationId  String     @map("organization_id")
  name            String
  email           String?
  phone           String?
  source          String?
  campaign        String?
  interest        String?
  status          LeadStatus @default(NOVO)
  consentGiven    Boolean    @default(false) @map("consent_given")
  consentDate     DateTime?  @map("consent_date")
  consentChannel  String?    @map("consent_channel")
  ownedBy         String?    @map("owned_by")
  convertedAt     DateTime?  @map("converted_at")
  convertedToPatientId String? @map("converted_to_patient_id")
  lossReason      String?    @map("loss_reason")
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  opportunities CrmOpportunity[]
  activities    CrmActivity[]

  @@index([organizationId])
  @@map("crm_leads")
}

model CrmOpportunity {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  leadId          String?           @map("lead_id")
  lead            CrmLead?          @relation(fields: [leadId], references: [id])
  funnelId        String            @map("funnel_id")
  funnel          CrmFunnel         @relation(fields: [funnelId], references: [id])
  stageId         String            @map("stage_id")
  stage           CrmFunnelStage    @relation(fields: [stageId], references: [id])
  title           String
  serviceId       String?           @map("service_id")
  value           Decimal?          @db.Decimal(15, 2)
  probability     Int               @default(50)
  expectedCloseDate DateTime?       @map("expected_close_date") @db.Date
  status          OpportunityStatus @default(ABERTA)
  ownedBy         String?           @map("owned_by")
  lossReason      String?           @map("loss_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  activities CrmActivity[]
  proposals  CrmProposal[]

  @@index([organizationId])
  @@index([funnelId, stageId])
  @@map("crm_opportunities")
}

model CrmActivity {
  id              String        @id @default(uuid())
  organizationId  String        @map("organization_id")
  leadId          String?       @map("lead_id")
  lead            CrmLead?      @relation(fields: [leadId], references: [id])
  opportunityId   String?       @map("opportunity_id")
  opportunity     CrmOpportunity? @relation(fields: [opportunityId], references: [id])
  type            ActivityType
  subject         String
  description     String?
  dueDate         DateTime?     @map("due_date")
  completedAt     DateTime?     @map("completed_at")
  performedBy     String        @map("performed_by")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([leadId])
  @@map("crm_activities")
}

model CrmProposal {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  opportunityId   String         @map("opportunity_id")
  opportunity     CrmOpportunity @relation(fields: [opportunityId], references: [id])
  title           String
  value           Decimal        @db.Decimal(15, 2)
  validUntil      DateTime?      @map("valid_until") @db.Date
  status          String         @default("RASCUNHO")
  content         String?        @db.Text
  acceptedAt      DateTime?      @map("accepted_at")
  acceptedBy      String?        @map("accepted_by")
  rejectedAt      DateTime?      @map("rejected_at")
  rejectionReason String?        @map("rejection_reason")
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("crm_proposals")
}

model CrmTemplate {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  name            String
  channel         String
  purpose         String
  subject         String?
  body            String    @db.Text
  approved        Boolean   @default(false)
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  active          Boolean   @default(true)
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("crm_templates")
}

model CrmTicket {
  id              String         @id @default(uuid())
  organizationId  String         @map("organization_id")
  leadId          String?        @map("lead_id")
  patientId       String?        @map("patient_id")
  subject         String
  category        String?
  status          CrmTicketStatus   @default(ABERTO)
  priority        CrmTicketPriority @default(MEDIA)
  assignedTo      String?        @map("assigned_to")
  slaDeadline     DateTime?      @map("sla_deadline")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  channel         String?
  createdBy       String         @map("created_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  messages CrmTicketMessage[]

  @@index([organizationId])
  @@map("crm_tickets")
}

model CrmTicketMessage {
  id          String     @id @default(uuid())
  ticketId    String     @map("ticket_id")
  ticket      CrmTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body        String     @db.Text
  authorSub   String     @map("author_sub")
  authorName  String     @map("author_name")
  isInternal  Boolean    @default(false) @map("is_internal")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("crm_ticket_messages")
}

// ============================================================
// RF-PAC-010: Auditoria de exportação e ações sensíveis de paciente
// ============================================================

// RF-PAC-010: Auditoria de exportação e ações sensíveis de paciente
model PatientAuditLog {
  id             String      @id @default(uuid())
  patientId      String      @map("patient_id")
  patient        Patient     @relation(fields: [patientId], references: [id])
  organizationId String      @map("organization_id")

  actorSub       String      @map("actor_sub")
  actorName      String      @map("actor_name")
  action         String      // VIEW, EXPORT, CONSENT_SIGN, CONSENT_REVOKE, ALERT_CREATE, DOC_UPLOAD, DOC_VIEW, LINK_CREATE
  resourceType   String      @map("resource_type")
  resourceId     String?     @map("resource_id")
  metadata       Json?       // finalidade, escopo, etc.

  occurredAt     DateTime    @default(now()) @map("occurred_at")

  @@index([patientId])
  @@map("patient_audit_logs")
}
