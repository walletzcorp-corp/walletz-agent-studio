# Copie para apps/web/.env.local (o Next.js só lê .env* desta pasta)
# URL base da API, SEM versão: as rotas reais são /api/v1/*
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Meta Embedded Signup (públicos, enviados ao browser)
NEXT_PUBLIC_META_APP_ID=REPLACE_WITH_META_APP_ID
NEXT_PUBLIC_META_CONFIG_ID=REPLACE_WITH_META_CONFIG_ID
