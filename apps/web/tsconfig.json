{
  "extends": "@walletz/config/typescript/nextjs",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@walletz/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@walletz/contracts": [
        "../../packages/contracts/src/index.ts"
      ]
    },
    "noEmit": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
