# Walletz Agent Studio — Environment Variables
# Dev local: copie este arquivo para apps/api/.env.local (NEVER commit .env.local).
# A API lê .env.local do diretório onde roda (apps/api), NÃO da raiz do repo.
# O frontend lê apps/web/.env.local — veja apps/web/.env.example.
# Suba a infra com: docker compose -f infra/docker/docker-compose.yml up -d
# All values here are examples — use real values in your environment

# ====================================================================
# Application
# ====================================================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
WORKER_URL=http://localhost:3002
# QUEUE_ROLE=all (padrão) | api (só enfileira) — com api, rode também: pnpm --filter @walletz/worker start

# ====================================================================
# Database (PostgreSQL)
# ====================================================================
DATABASE_URL=postgresql://walletz:walletz_dev_password@localhost:5432/walletz_dev
DATABASE_TEST_URL=postgresql://walletz:walletz_dev_password@localhost:5432/walletz_test

# ====================================================================
# Redis
# ====================================================================
REDIS_URL=redis://:walletz_redis_dev@localhost:6379

# ====================================================================
# Storage (S3-compatible / MinIO)
# ====================================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=walletz_minio
STORAGE_SECRET_KEY=walletz_minio_dev_password
STORAGE_BUCKET_UPLOADS=walletz-uploads
STORAGE_BUCKET_KNOWLEDGE=walletz-knowledge
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000

# ====================================================================
# Auth (JWT)
# ====================================================================
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING_64_CHARS_MIN
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ====================================================================
# LLM Provider (Anthropic Claude)
# ====================================================================
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6
ANTHROPIC_EMBEDDING_MODEL=voyage-3

# ====================================================================
# WhatsApp Business Platform / Meta Embedded Signup — BLOCKER-001
# ====================================================================
# Meta App credentials (register at https://developers.facebook.com)
META_APP_ID=REPLACE_WITH_META_APP_ID
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET
# Embedded Signup Configuration ID (from Meta Business Settings > Embedded Signup)
META_CONFIG_ID=REPLACE_WITH_META_CONFIG_ID
# Webhook verify token (any random secret string — generated by Walletz, not by user)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Legacy fields — only needed for manual connection (advanced users)
# WHATSAPP_ACCESS_TOKEN=REPLACE_AFTER_META_APPROVAL
# WHATSAPP_PHONE_NUMBER_ID=REPLACE_AFTER_META_APPROVAL
# WHATSAPP_WABA_ID=REPLACE_AFTER_META_APPROVAL

# Frontend — Embedded Signup (public, sent to browser)
NEXT_PUBLIC_META_APP_ID=REPLACE_WITH_META_APP_ID
NEXT_PUBLIC_META_CONFIG_ID=REPLACE_WITH_META_CONFIG_ID

# ====================================================================
# Google Calendar OAuth — BLOCKER-002
# ====================================================================
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Cadastre exatamente esta URI no Google Cloud Console (rota real da API: /api/v1/...)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/tenants/callback/google

# ====================================================================
# Microsoft Graph OAuth — BLOCKER-003
# ====================================================================
MICROSOFT_OAUTH_CLIENT_ID=REPLACE_WITH_AZURE_CLIENT_ID
MICROSOFT_OAUTH_CLIENT_SECRET=REPLACE_WITH_AZURE_CLIENT_SECRET
MICROSOFT_OAUTH_TENANT_ID=common
# Cadastre exatamente esta URI no Azure App Registration (rota real da API: /api/v1/...)
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/tenants/callback/microsoft

# ====================================================================
# Billing (Stripe) — BLOCKER-004
# ====================================================================
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SECRET

# ====================================================================
# Encryption (for OAuth tokens at rest)
# ====================================================================
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_STRING_64_CHARS
# Calendar tokens encryption (AES-256-GCM) — must be stable across restarts
CALENDAR_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_STRING_64_CHARS
# OAuth state HMAC secret — prevents CSRF in OAuth flows
CALENDAR_OAUTH_STATE_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_64_CHARS_MIN

# ====================================================================
# Observability
# ====================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=walletz-agent-studio
LOG_LEVEL=debug

# ====================================================================
# Security
# ====================================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ====================================================================
# Features Flags (development defaults)
# ====================================================================
FEATURE_WHATSAPP_ENABLED=false
FEATURE_GOOGLE_CALENDAR_ENABLED=false
FEATURE_MICROSOFT_CALENDAR_ENABLED=false
FEATURE_BILLING_ENABLED=false

# ====================================================================
# Email (SMTP) — required for email verification and password reset
# ====================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@walletz.com.br
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@walletz.com.br

# App URL (used in email links)
APP_URL=http://localhost:3000
