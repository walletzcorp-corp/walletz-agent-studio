# =============================================================
# Walletz Med — Variáveis de Ambiente
# Copie para .env e ajuste para seu ambiente local
# NÃO commite o arquivo .env com valores reais
# PORTAS: web=3010, api=3011, postgres=5433, keycloak=8090, mailpit=8025
# =============================================================

# ---- Aplicação ----
NODE_ENV=development
APP_PORT=3011
APP_URL=http://localhost:3011
WEB_URL=http://localhost:3010

NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=walletz-med-nextauth-secret-dev
NEXT_PUBLIC_API_URL=http://localhost:3011

# ---- Banco de Dados (Docker na porta 5433 para não conflitar com PostgreSQL local) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=walletz_med
POSTGRES_USER=walletz_app
POSTGRES_PASSWORD=walletz_dev_password_change_in_prod
DATABASE_URL="postgresql://walletz_app:walletz_dev_password_change_in_prod@localhost:5433/walletz_med?schema=public"
DATABASE_URL_SHADOW="postgresql://walletz_app:walletz_dev_password_change_in_prod@localhost:5433/walletz_med_shadow?schema=public"

# ---- Keycloak (OIDC) ----
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=walletz-med
KEYCLOAK_CLIENT_ID=walletz-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

# ---- JWT ----
JWT_ISSUER=http://localhost:8090/realms/walletz-med
JWT_AUDIENCE=account

# ---- Mailpit (e-mail dev) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@walletz-med.local
MAILPIT_UI=http://localhost:8025

# ---- Segurança ----
CORS_ORIGINS=http://localhost:3010
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- Logs ----
LOG_LEVEL=debug
