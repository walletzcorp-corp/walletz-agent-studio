{
  "name": "walletz-agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Walletz Agent Studio — SaaS B2B no-code para criação e operação de agentes de IA",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:security": "turbo run test:security",
    "test:isolation": "turbo run test:isolation",
    "test:evals": "turbo run test:evals",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "ci": "turbo run lint typecheck test build",
    "db:migrate": "turbo run db:migrate --filter=@walletz/api",
    "db:migrate:dry": "turbo run db:migrate:dry --filter=@walletz/api",
    "db:studio": "turbo run db:studio --filter=@walletz/api",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.1"
}
