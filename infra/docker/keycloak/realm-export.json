{
  "id": "walletz-med",
  "realm": "walletz-med",
  "displayName": "Walletz Med",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "walletz-api",
      "name": "Walletz Med API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "walletz-api-secret-change-in-prod",
      "redirectUris": ["http://localhost:3010/*", "http://localhost:3011/*"],
      "webOrigins": ["http://localhost:3010", "http://localhost:3011"],
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "defaultClientScopes": ["openid", "profile", "email"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "walletz-web",
      "name": "Walletz Med Web",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3010/*"],
      "webOrigins": ["http://localhost:3010"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["openid", "profile", "email"]
    }
  ],
  "users": [
    {
      "username": "dev-admin",
      "email": "dev-admin@walletz-med.local",
      "firstName": "Dev",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-walletz-med"]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "walletz-admin",
        "description": "Administrador global do Walletz Med"
      }
    ]
  }
}
